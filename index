                            <div class="text-2xl font-bold text-red-500 mt-1">${debtStudents} tələbə</div>
                        </div>
                        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
                            <span class="text-xs text-slate-400 font-medium">Aktiv Tələbə Sayı</span>
                            <div class="text-2xl font-bold text-orange-500 mt-1">${db.students.length} şagird</div>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-base font-bold text-slate-800 mb-4">Qruplar üzrə Paket Yenilənməsi</h3>
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            ${db.groups.map(g => {
                                const grpStudents = db.students.filter(s => s.type === 'group' && s.group_id === g.group_id);
                                return `
                                <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
                                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                                        <h4 class="font-bold text-slate-900 text-base">${g.group_name}</h4>
                                        <button data-action="select-all-group" data-group-id="${g.group_id}" class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold">Hamısını seç</button>
                                    </div>
                                    <div class="space-y-2 mb-5">
                                        ${grpStudents.map(st => `
                                            <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-100">
                                                <label class="flex items-center gap-2.5 cursor-pointer">
                                                    <input type="checkbox" checked value="${st.id}" data-group-id="${g.group_id}" class="pay-grp-student-check custom-checkbox w-4 h-4 rounded">
                                                    <span class="text-xs font-semibold text-slate-800 hover:text-orange-600" data-action="view-student" data-id="${st.id}">${st.student_name}</span>
                                                </label>
                                                <span class="text-[11px] font-semibold text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-md">${st.lessons_completed || 0}/${st.package_type || 8}</span>
                                            </div>
                                        `).join('')}
                                    </div>
                                    <button data-action="renew-group-package" data-group-id="${g.group_id}" class="w-full py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-xl text-xs font-bold shadow-md shadow-orange-500/20 transition">
                                        Seçilənlər üçün yeni paketə başla (0 dərs)
                                    </button>
                                </div>`;
                            }).join('')}
                        </div>
                    </div>

                    <div>
                        <h3 class="text-base font-bold text-slate-800 mb-4">Fərdi Tələbələr</h3>
                        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
                            <table class="w-full text-left text-xs text-slate-700">
                                <thead class="bg-slate-50 border-b border-slate-100 font-bold uppercase text-slate-500">
                                    <tr>
                                        <th class="p-4">Tələbə</th>
                                        <th class="p-4">Müəllim</th>
                                        <th class="p-4">Status</th>
                                        <th class="p-4">Qiymət</th>
                                        <th class="p-4 text-right">Əməliyyat</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    ${individualStudents.map(s => `
                                        <tr class="hover:bg-slate-50/60 transition">
                                            <td class="p-4 font-semibold text-slate-900 cursor-pointer hover:text-orange-600" data-action="view-student" data-id="${s.id}">${s.student_name}</td>
                                            <td class="p-4">${s.teacher_login || '-'}</td>
                                            <td class="p-4 font-bold text-slate-800">${s.lessons_completed || 0} / ${s.package_type || 8}</td>
                                            <td class="p-4 font-semibold">${s.package_price || 0} AZN</td>
                                            <td class="p-4 text-right">
                                                <button data-action="renew-indiv-package" data-id="${s.id}" class="py-1.5 px-3 bg-orange-50 text-orange-600 hover:bg-orange-500 hover:text-white rounded-xl font-semibold transition">
                                                    Yeni Paket
                                                </button>
                                            </td>
                                        </tr>`).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>`;
            }

            if (currentAdminTab === 'groups') {
                return `
                <div class="space-y-6 animate-fade-in">
                    <div class="flex justify-between items-center">
                        <h2 class="text-xl font-bold text-slate-900">Qruplar</h2>
                        <button id="btn-open-add-group" class="py-2.5 px-4 bg-orange-500 hover:bg-orange-600 text-white rounded-xl text-xs font-semibold shadow-md shadow-orange-500/20">+ Qrup əlavə et</button>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        ${db.groups.map(g => {
                            const teacher = db.users.find(u => u.login === g.teacher_login);
                            const members = db.students.filter(s => s.type === 'group' && s.group_id === g.group_id);
                            return `
                            <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm flex flex-col justify-between">
                                <div>
                                    <div class="flex justify-between items-center mb-2">
                                        <span class="text-[10px] font-bold text-orange-600 bg-orange-50 px-2.5 py-1 rounded-lg">ID: ${g.group_id}</span>
                                        <button data-action="delete-group" data-id="${g.group_id}" class="text-slate-300 hover:text-red-500 p-1"><i class="fa-solid fa-trash-can"></i></button>
                                    </div>
                                    <h3 class="font-bold text-slate-900 text-base mb-1">${g.group_name}</h3>
                                    <p class="text-xs text-slate-500 mb-4">Müəllim: <strong>${teacher ? teacher.name : g.teacher_login}</strong></p>
                                    <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100">
                                        <div class="text-[11px] font-bold text-slate-600 mb-2">Qrup Üzvləri (${members.length}):</div>
                                        <ul class="space-y-1 max-h-32 overflow-y-auto">
                                            ${members.map(m => `<li class="text-xs text-slate-700 cursor-pointer hover:text-orange-600" data-action="view-student" data-id="${m.id}"><i class="fa-solid fa-user-circle text-slate-400 mr-1"></i>${m.student_name}</li>`).join('')}
                                        </ul>
                                    </div>
                                </div>
                            </div>`;
                        }).join('')}
                    </div>
                </div>`;
            }

            if (currentAdminTab === 'users') {
                return `
                <div class="space-y-6 animate-fade-in">
                    <div class="flex justify-between items-center">
                        <h2 class="text-xl font-bold text-slate-900">İstifadəçilər</h2>
                        <button id="btn-open-add-user" class="py-2.5 px-4 bg-orange-500 hover:bg-orange-600 text-white rounded-xl text-xs font-semibold shadow-md shadow-orange-500/20">+ İstifadəçi Əlavə Et</button>
                    </div>
                    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
                        <table class="w-full text-left text-xs text-slate-700">
                            <thead class="bg-slate-50 border-b border-slate-100 font-bold uppercase text-slate-500">
                                <tr>
                                    <th class="p-4">Ad / Login</th>
                                    <th class="p-4">Rol</th>
                                    <th class="p-4">Təyinat</th>
                                    <th class="p-4 text-right">Əməliyyat</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                ${renderUserRows(db)}
                            </tbody>
                        </table>
                    </div>
                </div>`;
            }

            if (currentAdminTab === 'logs') {
                return `
                <div class="space-y-6 animate-fade-in">
                    <h2 class="text-xl font-bold text-slate-900">Aktivlik Tarixçəsi</h2>
                    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
                        <table class="w-full text-left text-xs text-slate-700">
                            <thead class="bg-slate-50 border-b border-slate-100 font-bold uppercase text-slate-500">
                                <tr>
                                    <th class="p-4">Tarix</th>
                                    <th class="p-4">İstifadəçi</th>
                                    <th class="p-4">Təfərrüat</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                ${db.logs.map(l => `
                                    <tr>
                                        <td class="p-4 text-slate-400 font-mono text-[11px]">${l.timestamp}</td>
                                        <td class="p-4 font-semibold">${l.actor}</td>
                                        <td class="p-4">${l.details}</td>
                                    </tr>`).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>`;
            }

            return '';
        }

        function renderUserRows(db) {
            let list = [
                ...db.users.map(u => ({ id: u.login, name: `${u.name} (@${u.login})`, role: u.role === 'admin' ? 'İnzibatçı' : 'Müəllim', subject: u.subject || '-', rawRole: u.role })),
                ...db.students.map(s => ({ id: s.id, name: s.student_name, role: 'Tələbə', subject: s.type === 'unassigned' ? 'Bölüşdürülməyib' : (s.group_id ? `Qrup: ${s.group_id}` : `Müəllim: ${s.teacher_login}`), rawRole: 'student', rawStudent: s }))
            ];

            return list.map(item => `
                <tr class="hover:bg-slate-50/60 transition">
                    <td class="p-4 font-semibold text-slate-900">${item.name}</td>
                    <td class="p-4"><span class="px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase bg-slate-100">${item.role}</span></td>
                    <td class="p-4">${item.subject}</td>
                    <td class="p-4 text-right flex justify-end gap-2">
                        ${item.rawRole === 'student' ? `
                            <button data-action="edit-student" data-id="${item.id}" class="text-slate-400 hover:text-orange-500 p-1" title="Redaktə et"><i class="fa-solid fa-pen"></i></button>
                        ` : ''}
                        ${item.rawRole !== 'admin' ? `
                            <button data-action="delete-user" data-id="${item.id}" data-role="${item.rawRole}" class="text-slate-300 hover:text-red-500 p-1" title="Sil"><i class="fa-solid fa-trash-can"></i></button>
                        ` : ''}
                    </td>
                </tr>
            `).join('');
        }

        function bindAdminEvents() {
            document.getElementById('btn-admin-logout')?.addEventListener('click', () => {
                currentUser = null;
                showToast('Sistemdən çıxış edildi');
                render();
            });

            ['payments', 'groups', 'users', 'logs'].forEach(tab => {
                document.getElementById(`admin-tab-${tab}`)?.addEventListener('click', () => {
                    currentAdminTab = tab;
                    render();
                });
            });

            document.querySelectorAll('[data-action="renew-group-package"]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const grpId = btn.getAttribute('data-group-id');
                    const checkboxes = document.querySelectorAll(`.pay-grp-student-check[data-group-id="${grpId}"]:checked`);
                    const selectedIds = Array.from(checkboxes).map(c => c.value);
                    if (selectedIds.length === 0) return showToast('Tələbə seçin!', 'error');

                    const res = await api.bulkRenewPackage(selectedIds);
                    showToast(res.message);
                    render();
                });
            });

            document.querySelectorAll('[data-action="renew-indiv-package"]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const stId = btn.getAttribute('data-id');
                    const res = await api.bulkRenewPackage([stId]);
                    showToast(res.message);
                    render();
                });
            });

            document.querySelectorAll('[data-action="delete-group"]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    if (confirm('Qrupu silmək istədiyinizdən əminsiniz? Tələbələr bölüşdürülməmiş statusuna keçəcək.')) {
                        await api.deleteGroup(btn.getAttribute('data-id'));
                        showToast('Qrup silindi.');
                        render();
                    }
                });
            });

            document.querySelectorAll('[data-action="delete-user"]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    if (confirm('Silmək istədiyinizdən əminsiniz?')) {
                        await api.deleteUser(btn.getAttribute('data-id'), btn.getAttribute('data-role'));
                        showToast('İstifadəçi silindi.');
                        render();
                    }
                });
            });
        }

        function bindGlobalEvents() {
            document.querySelectorAll('#btn-sync').forEach(btn => {
                btn.addEventListener('click', async () => {
                    btn.querySelector('i').classList.add('fa-spin');
                    await fetchRemoteData();
                    showToast('Məlumatlar yeniləndi!');
                    render();
                });
            });

            document.querySelectorAll('[data-action="view-student"]').forEach(el => {
                el.addEventListener('click', () => {
                    const stId = el.getAttribute('data-id');
                    const db = getDB();
                    const st = db.students.find(s => s.id === stId);
                    if (!st) return;

                    document.getElementById('hist-student-name').innerText = st.student_name;
                    document.getElementById('hist-student-sub').innerText = `Paket: ${st.package_type} dərs | Keçilib: ${st.lessons_completed}`;

                    let hist = [];
                    try { hist = typeof st.history === 'string' ? JSON.parse(st.history) : (st.history || []); } catch(e){}
                    const histContainer = document.getElementById('hist-attendance-list');
                    if (hist.length === 0) {
                        histContainer.innerHTML = `<p class="text-slate-400 italic">Dərs iştirakı yoxdur.</p>`;
                    } else {
                        histContainer.innerHTML = hist.map(h => `
                            <div class="flex justify-between items-center p-2 bg-white rounded-xl border border-slate-100">
                                <span class="font-mono text-slate-500">${h.date}</span>
                                <span class="font-bold ${h.status === 'present' ? 'text-green-600' : 'text-red-500'}">${h.status === 'present' ? 'İştirak etdi' : 'NB (' + (h.reason || 'Səbəbsiz') + ')'}</span>
                            </div>
                        `).join('');
                    }

                    let cycles = [];
                    try { cycles = typeof st.payment_cycles === 'string' ? JSON.parse(st.payment_cycles) : (st.payment_cycles || []); } catch(e){}
                    const cyclesContainer = document.getElementById('hist-cycles-list');
                    if (cycles.length === 0) {
                        cyclesContainer.innerHTML = `<p class="text-slate-400 italic">Ödəniş tarixi yoxdur.</p>`;
                    } else {
                        cyclesContainer.innerHTML = cycles.map(c => `
                            <div class="flex justify-between items-center p-2 bg-white rounded-xl border border-slate-100">
                                <div>
                                    <div class="font-semibold text-slate-800">${c.package_type} dərslik paket (${c.price || 0} AZN)</div>
                                    <div class="text-[10px] text-slate-400">${c.date}</div>
                                </div>
                                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold ${c.status === 'paid' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">${c.status}</span>
                            </div>
                        `).join('');
                    }

                    document.getElementById('modal-student-history').classList.remove('hidden');
                });
            });

            document.querySelectorAll('[data-action="edit-student"]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const stId = btn.getAttribute('data-id');
                    const db = getDB();
                    const st = db.students.find(s => s.id === stId);
                    if (!st) return;

                    document.getElementById('edit-st-id').value = st.id;
                    document.getElementById('edit-st-name').value = st.student_name;
                    document.getElementById('edit-st-type').value = st.type || 'individual';
                    document.getElementById('edit-st-pkg').value = st.package_type || 8;
                    document.getElementById('edit-st-price').value = st.package_price || 0;
                    document.getElementById('edit-st-status').value = st.payment_status || 'paid';

                    const tSelect = document.getElementById('edit-st-teacher');
                    tSelect.innerHTML = `<option value="">Seçilməyib</option>` + db.users.filter(u => u.role === 'teacher').map(t => `<option value="${t.login}" ${st.teacher_login === t.login ? 'selected' : ''}>${t.name}</option>`).join('');

                    const gSelect = document.getElementById('edit-st-group');
                    gSelect.innerHTML = `<option value="">Seçilməyib</option>` + db.groups.map(g => `<option value="${g.group_id}" ${st.group_id === g.group_id ? 'selected' : ''}>${g.group_name}</option>`).join('');

                    document.getElementById('modal-edit-student').classList.remove('hidden');
                });
            });

            document.getElementById('form-edit-student')?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const stData = {
                    id: document.getElementById('edit-st-id').value,
                    student_name: document.getElementById('edit-st-name').value.trim(),
                    type: document.getElementById('edit-st-type').value,
                    package_type: document.getElementById('edit-st-pkg').value,
                    teacher_login: document.getElementById('edit-st-teacher').value,
                    group_id: document.getElementById('edit-st-group').value,
                    package_price: document.getElementById('edit-st-price').value,
                    payment_status: document.getElementById('edit-st-status').value
                };
                await api.editStudent(stData);
                showToast('Şagird məlumatları yeniləndi!');
                document.getElementById('modal-edit-student').classList.add('hidden');
                render();
            });

            document.querySelectorAll('.btn-close-modal').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('modal-student-history')?.classList.add('hidden');
                    document.getElementById('modal-edit-student')?.classList.add('hidden');
                });
            });
        }

        window.addEventListener('DOMContentLoaded', async () => {
            await fetchRemoteData();
            render();
        });
    </script>
</body>
</html>
