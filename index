<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aslan Lessons - Tədris Mərkəzi İdarəetmə Sistemi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Poppins', 'sans-serif'] },
                    colors: {
                        brand: { DEFAULT: '#FF7A00', hover: '#E06B00', light: '#FFF5EC', border: '#FFD1A8' }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #FAFAFA; color: #1F2937; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #F1F1F1; }
        ::-webkit-scrollbar-thumb { background: #D1D5DB; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #FF7A00; }
        .animate-fade-in { animation: fadeIn 0.25s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
        .custom-checkbox { accent-color: #FF7A00; }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between text-slate-800 bg-slate-50 selection:bg-orange-500 selection:text-white">

    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>
    <div id="tooltip-popover" class="hidden absolute z-50 max-w-xs p-2.5 bg-slate-900 text-white text-xs rounded-lg shadow-xl pointer-events-none transition-opacity duration-200"></div>

    <div id="app" class="flex-grow flex flex-col"></div>

    <!-- Modal History -->
    <div id="modal-student-history" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 animate-fade-in max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                <div>
                    <h3 id="hist-student-name" class="font-bold text-slate-900 text-lg"></h3>
                    <p id="hist-student-sub" class="text-xs text-slate-500"></p>
                </div>
                <button class="btn-close-modal text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            
            <div class="space-y-4">
                <div>
                    <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Dərs İştirakı Tarixçəsi</h4>
                    <div id="hist-attendance-list" class="max-h-40 overflow-y-auto space-y-1.5 p-2 bg-slate-50 rounded-2xl border border-slate-100 text-xs"></div>
                </div>
                <div>
                    <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Keçmiş Ödəniş Siklləri</h4>
                    <div id="hist-cycles-list" class="max-h-40 overflow-y-auto space-y-1.5 p-2 bg-slate-50 rounded-2xl border border-slate-100 text-xs"></div>
                </div>
            </div>
            <div class="mt-6 flex justify-end">
                <button class="btn-close-modal px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold">Bağla</button>
            </div>
        </div>
    </div>

    <!-- Modal Edit Student -->
    <div id="modal-edit-student" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 animate-fade-in">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                <h3 class="font-bold text-slate-900 text-base flex items-center gap-2"><i class="fa-solid fa-pen-to-square text-orange-500"></i> Şagird Redaktəsi</h3>
                <button class="btn-close-modal text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="form-edit-student" class="space-y-3 text-xs">
                <input type="hidden" id="edit-st-id">
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Ad və Soyad</label>
                    <input type="text" id="edit-st-name" required class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:border-orange-500">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Tədris Tipi</label>
                        <select id="edit-st-type" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:border-orange-500">
                            <option value="individual">Fərdi</option>
                            <option value="group">Qrup</option>
                            <option value="unassigned">Bölüşdürülməyib</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Paket Norması</label>
                        <select id="edit-st-pkg" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:border-orange-500">
                            <option value="8">8 dərs</option>
                            <option value="12">12 dərs</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Müəllim</label>
                        <select id="edit-st-teacher" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:border-orange-500"></select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Qrup ID</label>
                        <select id="edit-st-group" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:border-orange-500"></select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Qiymət (AZN)</label>
                        <input type="number" id="edit-st-price" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:border-orange-500" placeholder="100">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Ödəniş Statusu</label>
                        <select id="edit-st-status" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:border-orange-500">
                            <option value="paid">Ödənilib</option>
                            <option value="debt">Borc var</option>
                        </select>
                    </div>
                </div>
                <div class="pt-3 flex justify-end gap-2">
                    <button type="button" class="btn-close-modal px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold">Ləğv et</button>
                    <button type="submit" class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-xl font-semibold shadow-md shadow-orange-500/20">Yadda Saxla</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const API_URL = "https://script.google.com/macros/s/AKfycbzeLz7h-n7Uht1cedsPt5lBz87vFf4_lwIQTKF4P38I_7-k7n2jRHyPJBlY32HSobHT/exec";
        const EMPTY_DB = { users: [], groups: [], students: [], logs: [] };

        function getDB() {
            const data = localStorage.getItem('aslan_db');
            return data ? JSON.parse(data) : EMPTY_DB;
        }

        function saveDB(db) {
            localStorage.setItem('aslan_db', JSON.stringify(db));
        }

        async function postToAppsScript(payload) {
            try {
                const response = await fetch(API_URL, {
                    method: "POST",
                    redirect: "follow",
                    headers: { "Content-Type": "text/plain;charset=utf-8" },
                    body: JSON.stringify(payload)
                });
                return await response.json();
            } catch (err) {
                console.error("Apps Script POST Error:", err);
                return { status: "error", message: err.toString() };
            }
        }

        async function fetchRemoteData() {
            try {
                const response = await fetch(API_URL);
                const data = await response.json();
                if (data.status === 'success') {
                    const db = {
                        users: data.users || [],
                        groups: data.groups || [],
                        students: data.students || [],
                        logs: data.logs || []
                    };
                    saveDB(db);
                    return db;
                }
            } catch (err) {
                console.warn('API xətası, daxili keş istifadə olunur:', err);
            }
            return getDB();
        }

        window.api = {
            login: async (username, password) => {
                const res = await postToAppsScript({
                    action: "LOGIN",
                    username: username,
                    password: password
                });

                if (res && res.status === 'success') {
                    await fetchRemoteData();
                    return { success: true, user: res.user };
                } else {
                    return { success: false, message: res.message || 'İstifadəçi adı və ya şifrə yanlışdır.' };
                }
            },

            markAttendance: async (params) => {
                const db = getDB();
                let logText = '';
                let studentsToUpdate = [];
                const nowStamp = new Date().toLocaleString('az-AZ');

                if (params.type === 'individual') {
                    const std = db.students.find(s => s.id === params.targetId);
                    if (std) {
                        const att = params.attendance[0];
                        let completed = parseInt(std.lessons_completed || 0);
                        let total = parseInt(std.package_type || 8);
                        
                        if (params.lessonIncrement && att.present) {
                            std.lessons_completed = Math.min(total, completed + 1).toString();
                        }

                        let hist = [];
                        try { hist = typeof std.history === 'string' ? JSON.parse(std.history) : (std.history || []); } catch(e){}
                        const record = { date: nowStamp, status: att.present ? 'present' : 'absent' };
                        if (!att.present && att.reason) record.reason = att.reason;
                        hist.push(record);
                        std.history = JSON.stringify(hist);
                        
                        if (!att.present) {
                            logText = `${std.student_name} üçün dərs qeydi: Qayıb (NB). Səbəb: ${att.reason || 'Bilmədən'}`;
                        } else {
                            logText = `${std.student_name} üçün dərs iştirakı qeydə alındı (${std.lessons_completed}/${std.package_type}).`;
                        }

                        studentsToUpdate.push({ id: std.id, status: att.present ? 'present' : 'absent', reason: att.reason || '' });
                    }
                } else if (params.type === 'group') {
                    const grp = db.groups.find(g => g.group_id === params.targetId);
                    if (grp) {
                        params.attendance.forEach(att => {
                            const st = db.students.find(s => s.id === att.studentId);
                            if (st) {
                                if (params.lessonIncrement && att.present) {
                                    let completed = parseInt(st.lessons_completed || 0);
                                    let total = parseInt(st.package_type || 8);
                                    st.lessons_completed = Math.min(total, completed + 1).toString();
                                }
                                let hist = [];
                                try { hist = typeof st.history === 'string' ? JSON.parse(st.history) : (st.history || []); } catch(e){}
                                const record = { date: nowStamp, status: att.present ? 'present' : 'absent' };
                                if (!att.present && att.reason) record.reason = att.reason;
                                hist.push(record);
                                st.history = JSON.stringify(hist);

                                studentsToUpdate.push({ id: att.studentId, status: att.present ? 'present' : 'absent', reason: att.reason || '' });
                            }
                        });
                        logText = `${grp.group_name} qrupu üçün dərs qeydə alındı.`;
                    }
                }

                saveDB(db);
                api.addLog(params.teacherLogin, 'ATTENDANCE', logText);

                postToAppsScript({
                    action: "MARK_LESSON",
                    actor: params.teacherLogin,
                    students: studentsToUpdate,
                    details: logText
                });

                return { success: true, message: 'Davamiyyət uğurla qeydə alındı.' };
            },

            undoLesson: async (studentId) => {
                const actor = currentUser ? currentUser.login : 'system';
                const res = await postToAppsScript({
                    action: "UNDO_LESSON",
                    actor: actor,
                    student_id: studentId
                });
                if (res.status === 'success') {
                    await fetchRemoteData();
                    return { success: true, message: 'Sonuncu dərs qeydi ləğv edildi.' };
                }
                return { success: false, message: res.message || 'Xəta baş verdi.' };
            },

            bulkRenewPackage: async (studentIds, price = 0, status = "paid") => {
                const db = getDB();
                const actor = currentUser ? currentUser.login : 'admin';
                let renewedNames = [];

                studentIds.forEach(id => {
                    const std = db.students.find(s => s.id === id);
                    if (std) {
                        std.lessons_completed = "0";
                        std.package_price = price;
                        std.payment_status = status;
                        renewedNames.push(std.student_name);
                    }
                });

                saveDB(db);
                const logDetails = `Yeni paket aktivləşdirildi (${studentIds.length} tələbə). Tələbələr: ${renewedNames.join(', ')}`;
                api.addLog(actor, 'PAYMENT', logDetails);

                postToAppsScript({
                    action: "UPDATE_PACKAGE",
                    actor: actor,
                    student_ids: studentIds,
                    price: price,
                    payment_status: status,
                    details: logDetails
                });

                return { success: true, message: 'Seçilmiş tələbələr üçün yeni paket başladı!' };
            },

            addGroup: async (groupData) => {
                const db = getDB();
                const newGrp = {
                    group_id: 'grp_' + Date.now(),
                    group_name: groupData.name,
                    teacher_login: groupData.teacherLogin,
                    package_type: groupData.totalPackage.toString()
                };
                db.groups.push(newGrp);

                if (groupData.studentIds && groupData.studentIds.length > 0) {
                    groupData.studentIds.forEach(stId => {
                        const st = db.students.find(s => s.id === stId);
                        if (st) {
                            st.type = 'group';
                            st.group_id = newGrp.group_id;
                            st.teacher_login = '';
                            st.lessons_completed = "0";
                        }
                    });
                }

                saveDB(db);
                const actor = currentUser ? currentUser.login : 'admin';
                api.addLog(actor, 'GROUP', `Yeni qrup yaradıldı: ${newGrp.group_name}`);

                postToAppsScript({
                    action: "CREATE_GROUP",
                    actor: actor,
                    group_id: newGrp.group_id,
                    group_name: newGrp.group_name,
                    teacher_login: newGrp.teacher_login,
                    package_type: newGrp.package_type,
                    student_ids: groupData.studentIds || []
                });

                return { success: true, group: newGrp };
            },

            deleteGroup: async (groupId) => {
                const db = getDB();
                const grpIndex = db.groups.findIndex(g => g.group_id === groupId);
                if (grpIndex !== -1) {
                    const name = db.groups[grpIndex].group_name;
                    db.students.forEach(st => {
                        if (st.group_id === groupId) {
                            st.type = 'unassigned';
                            st.group_id = '';
                            st.teacher_login = '';
                            st.package_type = '8';
                            st.lessons_completed = '0';
                        }
                    });
                    db.groups.splice(grpIndex, 1);
                    saveDB(db);
                    const actor = currentUser ? currentUser.login : 'admin';
                    api.addLog(actor, 'GROUP', `Qrup silindi: ${name}`);

                    postToAppsScript({ action: "DELETE_GROUP", actor: actor, group_id: groupId });
                    return { success: true };
                }
            },

            addUser: async (userData) => {
                const db = getDB();
                const actor = currentUser ? currentUser.login : 'admin';

                if (userData.role === 'teacher') {
                    const exists = db.users.some(u => u.login.toLowerCase() === userData.username.toLowerCase());
                    if (exists) {
                        return { success: false, message: `İstifadəçi adı '${userData.username}' artıq mövcuddur!` };
                    }
                }

                if (userData.role === 'student') {
                    const newStudent = {
                        id: 'st_' + Date.now(),
                        student_name: userData.name,
                        type: userData.type || 'individual',
                        group_id: userData.groupId || '',
                        teacher_login: userData.teacherLogin || '',
                        package_type: (userData.totalPackage || 8).toString(),
                        lessons_completed: "0",
                        added_date: new Date().toISOString().split('T')[0],
                        history: "[]",
                        package_price: userData.price || 0,
                        payment_status: "paid"
                    };
                    db.students.push(newStudent);
                    saveDB(db);
                    api.addLog(actor, 'USER', `Yeni tələbə əlavə edildi: ${newStudent.student_name}`);

                    postToAppsScript({ action: "ADD_STUDENT", actor: actor, student_data: newStudent });
                    return { success: true, data: newStudent };
                } else {
                    const newUser = {
                        login: userData.username,
                        name: userData.name,
                        role: 'teacher',
                        subject: userData.subject || 'Ümumi'
                    };
                    db.users.push(newUser);
                    saveDB(db);
                    api.addLog(actor, 'USER', `Yeni müəllim əlavə edildi: ${newUser.name}`);

                    const res = await postToAppsScript({
                        action: "ADD_TEACHER",
                        actor: actor,
                        teacher_data: { login: userData.username, password: userData.password || 'pass123', name: userData.name, subject: userData.subject }
                    });

                    if (res.status === 'error') return { success: false, message: res.message };
                    return { success: true, data: newUser };
                }
            },

            editStudent: async (studentData) => {
                const db = getDB();
                const idx = db.students.findIndex(s => s.id === studentData.id);
                if (idx !== -1) {
                    db.students[idx] = { ...db.students[idx], ...studentData };
                    saveDB(db);
                    const actor = currentUser ? currentUser.login : 'admin';
                    api.addLog(actor, 'USER', `Şagird məlumatları redaktə edildi: ${studentData.student_name}`);

                    postToAppsScript({
                        action: "EDIT_STUDENT",
                        actor: actor,
                        student_data: studentData
                    });
                    return { success: true };
                }
                return { success: false, message: 'Şagird tapılmadı' };
            },

            deleteUser: async (idOrLogin, role) => {
                const db = getDB();
                const actor = currentUser ? currentUser.login : 'admin';

                if (role === 'student') {
                    const idx = db.students.findIndex(s => s.id === idOrLogin);
                    if (idx !== -1) {
                        const name = db.students[idx].student_name;
                        db.students.splice(idx, 1);
                        saveDB(db);
                        api.addLog(actor, 'USER', `Tələbə silindi: ${name}`);
                        postToAppsScript({ action: "DELETE_STUDENT", actor: actor, id: idOrLogin });
                    }
                } else {
                    const idx = db.users.findIndex(u => u.login === idOrLogin);
                    if (idx !== -1) {
                        const name = db.users[idx].name;
                        db.users.splice(idx, 1);
                        saveDB(db);
                        api.addLog(actor, 'USER', `Müəllim silindi: ${name}`);
                        postToAppsScript({ action: "DELETE_TEACHER", actor: actor, login: idOrLogin });
                    }
                }
                return { success: true };
            },

            addLog: (actor, action_type, details) => {
                const db = getDB();
                const now = new Date();
                const dateStr = now.toLocaleDateString('az-AZ') + ' ' + now.toLocaleTimeString('az-AZ');
                db.logs.unshift({ timestamp: dateStr, actor, action_type, details });
                saveDB(db);
            }
        };

        let currentUser = null;
        let currentAdminTab = 'payments';
        let currentTeacherTab = 'individual';

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl shadow-lg border border-slate-100 text-sm font-medium transition-all duration-300 transform translate-x-full bg-white text-slate-800 border-l-4 ${type === 'success' ? 'border-l-orange-500' : type === 'error' ? 'border-l-red-500' : 'border-l-blue-500'}`;
            const iconClass = type === 'success' ? 'fa-circle-check text-orange-500' : type === 'error' ? 'fa-circle-xmark text-red-500' : 'fa-circle-info text-blue-500';
            toast.innerHTML = `<i class="fa-solid ${iconClass} text-base"></i><span>${message}</span>`;
            container.appendChild(toast);
            requestAnimationFrame(() => toast.classList.remove('translate-x-full'));
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-x-full');
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        function setupTooltips() {
            const tooltip = document.getElementById('tooltip-popover');
            document.querySelectorAll('[data-tooltip]').forEach(el => {
                el.addEventListener('mouseenter', (e) => {
                    tooltip.innerHTML = el.getAttribute('data-tooltip');
                    tooltip.classList.remove('hidden');
                    const rect = el.getBoundingClientRect();
                    tooltip.style.top = `${rect.bottom + window.scrollY + 6}px`;
                    tooltip.style.left = `${Math.max(10, rect.left + window.scrollX - 40)}px`;
                });
                el.addEventListener('mouseleave', () => tooltip.classList.add('hidden'));
            });
        }

        function render() {
            const app = document.getElementById('app');
            if (!currentUser) {
                app.innerHTML = renderLoginScreen();
                bindLoginEvents();
            } else if (currentUser.role === 'teacher') {
                app.innerHTML = renderTeacherPanel();
                bindTeacherEvents();
            } else if (currentUser.role === 'admin') {
                app.innerHTML = renderAdminPanel();
                bindAdminEvents();
            }
            bindGlobalEvents();
            setupTooltips();
        }

        function getBrandLogo(size = 'w-10 h-10') {
            return `
            <div class="${size} bg-orange-500 text-white rounded-2xl flex items-center justify-center shadow-md shadow-orange-500/20">
                <svg class="w-3/5 h-3/5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2L1 7l11 5 9-4.09V17h2V7L12 2zm0 8.74L4.25 7 12 3.5 19.75 7 12 10.74zM4.5 10.5v6.27L12 21l7.5-4.23V10.5L12 14.75 4.5 10.5z"/>
                </svg>
            </div>`;
        }

        function renderLoginScreen() {
            return `
            <div class="min-h-screen flex items-center justify-center p-4 bg-slate-50">
                <div class="bg-white p-8 md:p-10 rounded-3xl shadow-xl shadow-slate-200/60 w-full max-w-md border border-slate-100 animate-fade-in">
                    <div class="flex flex-col items-center mb-8 text-center">
                        ${getBrandLogo('w-16 h-16 mb-3')}
                        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Aslan Lessons</h1>
                        <p class="text-xs text-slate-500 mt-1 font-medium">Tədris Mərkəzi İdarəetmə Sistemi</p>
                    </div>
                    <form id="login-form" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1.5">İstifadəçi adı</label>
                            <div class="relative">
                                <i class="fa-solid fa-user absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
