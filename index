        function bindTeacherEvents() {
            document.getElementById('btn-logout')?.addEventListener('click', () => {
                currentUser = null;
                showToast('Sistemdən çıxış edildi');
                render();
            });

            document.getElementById('tab-indiv')?.addEventListener('click', () => { currentTeacherTab = 'individual'; render(); });
            document.getElementById('tab-groups')?.addEventListener('click', () => { currentTeacherTab = 'groups'; render(); });

            let pendingNbStudent = null;

            document.querySelectorAll('[data-action="mark-present"]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const stId = btn.getAttribute('data-id');
                    const res = await api.markAttendance({
                        teacherLogin: currentUser.login,
                        type: 'individual',
                        targetId: stId,
                        attendance: [{ studentId: stId, present: true }],
                        lessonIncrement: true
                    });
                    showToast(res.message);
                    render();
                });
            });

            document.querySelectorAll('[data-action="undo-lesson"]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const stId = btn.getAttribute('data-id');
                    if (confirm('Sonuncu dərs qeydini ləğv etmək istədiyinizdən əminsiniz?')) {
                        const res = await api.undoLesson(stId);
                        showToast(res.message, res.success ? 'success' : 'error');
                        render();
                    }
                });
            });

            document.querySelectorAll('[data-action="mark-nb"]').forEach(btn => {
                btn.addEventListener('click', () => {
                    pendingNbStudent = { id: btn.getAttribute('data-id'), name: btn.getAttribute('data-name'), type: 'individual' };
                    document.getElementById('nb-student-name').innerText = pendingNbStudent.name;
                    document.getElementById('nb-modal').classList.remove('hidden');
                });
            });

            const nbSelect = document.getElementById('nb-reason-select');
            const nbCustom = document.getElementById('nb-reason-custom');
            nbSelect?.addEventListener('change', () => {
                nbCustom.classList.toggle('hidden', nbSelect.value !== 'custom');
            });

            document.getElementById('btn-close-nb')?.addEventListener('click', () => document.getElementById('nb-modal').classList.add('hidden'));
            document.getElementById('btn-cancel-nb')?.addEventListener('click', () => document.getElementById('nb-modal').classList.add('hidden'));

            document.getElementById('btn-save-nb')?.addEventListener('click', async () => {
                let reason = nbSelect.value === 'custom' ? nbCustom.value.trim() : nbSelect.value;
                if (!reason) { showToast('Qayıb səbəbini qeyd edin!', 'error'); return; }

                if (pendingNbStudent.type === 'individual') {
                    await api.markAttendance({
                        teacherLogin: currentUser.login,
                        type: 'individual',
                        targetId: pendingNbStudent.id,
                        attendance: [{ studentId: pendingNbStudent.id, present: false, reason }],
                        lessonIncrement: false
                    });
                    showToast(`Qayıb qeydə alındı: ${pendingNbStudent.name}`);
                } else if (pendingNbStudent.type === 'group_student') {
                    const badge = document.getElementById(`nb-reason-badge-${pendingNbStudent.id}`);
                    if (badge) {
                        badge.innerText = `NB: ${reason}`;
                        badge.setAttribute('data-nb-reason', reason);
                        badge.classList.remove('hidden');
                    }
                }
                document.getElementById('nb-modal').classList.add('hidden');
                if (pendingNbStudent.type === 'individual') render();
            });

            document.querySelectorAll('.group-att-checkbox').forEach(chk => {
                chk.addEventListener('change', () => {
                    const stId = chk.getAttribute('data-student-id');
                    const badge = document.getElementById(`nb-reason-badge-${stId}`);
                    if (!chk.checked) {
                        const db = getDB();
                        const st = db.students.find(s => s.id === stId);
                        pendingNbStudent = { id: stId, name: st ? st.student_name : 'Tələbə', type: 'group_student' };
                        document.getElementById('nb-student-name').innerText = pendingNbStudent.name;
                        document.getElementById('nb-modal').classList.remove('hidden');
                    } else {
                        if (badge) { badge.classList.add('hidden'); badge.removeAttribute('data-nb-reason'); }
                    }
                });
            });

            document.querySelectorAll('[data-action="submit-group-lesson"]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const groupId = btn.getAttribute('data-group-id');
                    const checkboxes = document.querySelectorAll(`.group-att-checkbox[data-group-id="${groupId}"]`);
                    let attendanceData = [];
                    let hasMissingReason = false;

                    checkboxes.forEach(chk => {
                        const stId = chk.getAttribute('data-student-id');
                        const isPresent = chk.checked;
                        const badge = document.getElementById(`nb-reason-badge-${stId}`);
                        const reason = badge ? badge.getAttribute('data-nb-reason') || '' : '';

                        if (!isPresent && !reason) hasMissingReason = true;
                        attendanceData.push({ studentId: stId, present: isPresent, reason: isPresent ? '' : reason });
                    });

                    if (hasMissingReason) {
                        showToast('Qayıb tələbələr üçün səbəb göstərilməlidir!', 'error');
                        return;
                    }

                    const res = await api.markAttendance({
                        teacherLogin: currentUser.login,
                        type: 'group',
                        targetId: groupId,
                        attendance: attendanceData,
                        lessonIncrement: true
                    });
                    showToast(res.message);
                    render();
                });
            });
        }

